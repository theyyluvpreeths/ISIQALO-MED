# Copy to .env and fill in. Never commit .env.
# Generate values with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs login sessions and document links
JWT_SECRET=

# Encrypts patient PII at rest. DO NOT change once real data exists — old records become unreadable.
ENCRYPTION_KEY=

# Optional overrides
# CORS_ORIGINS=http://localhost:5000
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
